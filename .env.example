# ─── Server ─────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000

# ─── Authentication ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# ─── Demo Mode ──────────────────────────────────────────────
# When true, password reset tokens are returned in API responses
# (useful for development frontends that need the token inline).
# Set to false in production.
DEMO_MODE=true

# ─── Database ───────────────────────────────────────────────
# Defaults to ./data.db if not set
DATABASE_PATH=

# ─── Email (SMTP) ───────────────────────────────────────────
# Leave blank to log emails to console instead of sending
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@habitflow.com
